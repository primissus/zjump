# shellcheck shell=bash

# =============================================================================
#
# Utility functions for zjump.
#

# pwd based on the value of _ZJUMP_RESOLVE_SYMLINKS.
function __zjump_pwd() {
    \builtin pwd {{- if .ResolveSymlinks }} -P{{ else }} -L{{ end }}
}

# cd + custom logic based on the value of _ZJUMP_ECHO.
function __zjump_cd() {
    # shellcheck disable=SC2164
    \builtin cd -- "$@"{{ if .Echo }} && __zjump_pwd{{ end }}
}

# __zjump wraps \command zjump, optionally injecting --debug --log-file when
# init was called with --debug[=PATH] (a zjump-only addition beyond parity).
__zjump() {
    {{- if .Debug }}
    \command zjump --debug --log-file "{{ .DebugLogFile }}" "$@"
    {{- else }}
    \command zjump "$@"
    {{- end }}
}

# Print the "zjump, jump command "<cmd>" v<version>" banner shown by --help,
# where <cmd> is the command the user invoked. The version is read from the
# binary at call time (not baked at init) so it stays correct after `zjump update`.
function __zjump_version_banner() {
    \builtin local cmd="$1" version=''
    version="$(__zjump --version 2>/dev/null)" && version="${version#* }"
    if [[ -n "${version}" ]]; then
        \builtin printf 'zjump, jump command "%s" v%s\n' "${cmd}" "${version}"
    else
        \builtin printf 'zjump, jump command "%s"\n' "${cmd}"
    fi
}

# =============================================================================
#
# Hook configuration for zjump.
#

# Hook to add new entries to the database.
function __zjump_hook() {
    # shellcheck disable=SC2312
    __zjump add -- "$(__zjump_pwd)"
}

# Initialize hook.
\builtin typeset -ga precmd_functions
\builtin typeset -ga chpwd_functions
# shellcheck disable=SC2034,SC2296
precmd_functions=("${(@)precmd_functions:#__zjump_hook}")
# shellcheck disable=SC2034,SC2296
chpwd_functions=("${(@)chpwd_functions:#__zjump_hook}")
{{ if eq .Hook "prompt" }}
precmd_functions+=(__zjump_hook)
{{- else if eq .Hook "pwd" }}
chpwd_functions+=(__zjump_hook)
{{- end }}

# Report common issues.
function __zjump_doctor() {
{{- if eq .Hook "none" }}
    return 0
{{- else }}
    [[ ${_ZJUMP_DOCTOR:-1} -ne 0 ]] || return 0
    [[ $- == *i* ]] || return 0
{{ if eq .Hook "prompt" }}
    [[ ${precmd_functions[(Ie)__zjump_hook]:-} -eq 0 ]] || return 0
{{- else if eq .Hook "pwd" }}
    [[ ${chpwd_functions[(Ie)__zjump_hook]:-} -eq 0 ]] || return 0
{{- end }}

    _ZJUMP_DOCTOR=0
    \builtin printf '%s\n' \
        'zjump: detected a possible configuration issue.' \
        'Please ensure that zjump is initialized right at the end of your shell configuration file (usually ~/.zshrc).' \
        '' \
        'Disable this message by setting _ZJUMP_DOCTOR=0.' \
        '' >&2
{{- end }}
}

# =============================================================================
#
# When using zjump with --no-cmd, alias these internal functions as desired.
#

# Jump to a directory using only keywords.
function __zjump_z() {
    __zjump_doctor
    if [[ "$#" -eq 1 && ( "$1" = '--help' || "$1" = '-h' ) ]]; then
        __zjump_version_banner "{{ .Cmd }}"
        \builtin printf '%s\n' \
            '' \
            'Usage: {{ .Cmd }} [OPTIONS] [KEYWORD]' \
            '' \
            'Jump to a directory using keywords or flags.' \
            '' \
            'Options:' \
            '  -a, --alias [<NAME> <PATH>] Jump to a named alias (no args = fzf);' \
            '                               set an alias with <NAME> <PATH>' \
            '  -b, --branch <BRANCH>        Jump to a git branch worktree' \
            '  -w, --worktree <NAME>        Jump to a git worktree by name' \
            '  -W, --worktree-all           fzf-pick worktrees across all repos' \
            '  -h, --help                   Show this help message' \
            '  -v, --version                Show version' \
            '' \
            'Without arguments, jumps to $HOME.' \
            'Use - to jump to the previous directory.' \
            'Use -- <PATH> to jump to an exact path.'
        return
    elif [[ "$#" -eq 1 && ( "$1" = '--version' || "$1" = '-v' ) ]]; then
        __zjump_version_banner "{{ .Cmd }}"
        return
    elif [[ "$#" -eq 0 ]]; then
        __zjump_cd ~
    elif [[ "$#" -eq 1 ]] && { [[ -d "$1" ]] || [[ "$1" = '-' ]] || [[ "$1" =~ ^[-+][0-9]+$ ]]; }; then
        __zjump_cd "$1"
    elif [[ "$#" -eq 2 ]] && [[ "$1" = "--" ]]; then
        __zjump_cd "$2"
    elif [[ "$1" = "-a" || "$1" = "--alias" ]]; then
        shift
        if [[ $# -eq 0 ]]; then
            \builtin local result
            result="$(__zjump alias --pick)" && __zjump_cd "${result}"
        else
            __zjump alias "$@"
        fi
    elif [[ "$1" = "-b" || "$1" = "--branch" ]]; then
        shift
        \builtin local result
        result="$(__zjump branch "$@")" && __zjump_cd "${result}"
    elif [[ "$1" = "-w" || "$1" = "--worktree" ]]; then
        shift
        \builtin local result
        result="$(__zjump worktree "$@")" && __zjump_cd "${result}"
    elif [[ "$1" = "-W" || "$1" = "--worktree-all" ]]; then
        shift
        \builtin local result
        result="$(__zjump worktree --all "$@")" && __zjump_cd "${result}"
    else
        \builtin local result
        # shellcheck disable=SC2312
        result="$(__zjump query --exclude "$(__zjump_pwd)" -- "$@")" && __zjump_cd "${result}"
    fi
}

# Jump to a directory using interactive search. Bare `-a`/`--alias` opens the
# alias picker ranked by each target's frecency score.
function __zjump_zi() {
    __zjump_doctor
    if [[ "$#" -eq 1 && ( "${1:-}" = '--help' || "${1:-}" = '-h' ) ]]; then
        __zjump_version_banner "{{ .Cmd }}i"
        \builtin printf '%s\n' \
            '' \
            'Usage: {{ .Cmd }}i [OPTIONS] [KEYWORD]' \
            '' \
            'Jump to a directory using interactive search.' \
            '' \
            'Options:' \
            '  -a, --alias   Interactively pick an alias, ranked by target frecency' \
            '  -h, --help    Show this help message' \
            '  -v, --version Show version'
        return
    elif [[ "$#" -eq 1 && ( "${1:-}" = '--version' || "${1:-}" = '-v' ) ]]; then
        __zjump_version_banner "{{ .Cmd }}i"
        return
    fi
    \builtin local result
    if [[ "$#" -eq 1 && ( "${1:-}" = "-a" || "${1:-}" = "--alias" ) ]]; then
        result="$(__zjump alias --pick --score)" && __zjump_cd "${result}"
    else
        result="$(__zjump query --interactive -- "$@")" && __zjump_cd "${result}"
    fi
}

# =============================================================================
#
# Commands for zjump. Disable these using --no-cmd.
#
{{ if .HasCmd }}
function {{ .Cmd }}() {
    __zjump_z "$@"
}

function {{ .Cmd }}i() {
    __zjump_zi "$@"
}
{{- else }}
# -- not configured --
{{- end }}

# Completions.
if [[ -o zle ]]; then
    __zjump_result=''

    # __zjump_complete_words fills the caller's candidate arrays (which must be
    # dynamically-scoped locals of __zjump_z_complete) from `zjump complete`
    # (a zjump-only extension). The match section is always offered so the
    # first Tab inserts the longest common prefix; the fuzzy (completion) and
    # frecency (indexed) sections are added only once zsh has already listed
    # matches — i.e. on the second Tab — so they never affect that prefix.
    function __zjump_complete_words() {
        local __zjump_group __zjump_word __zjump_desc
        local __zjump_old_list="${compstate[old_list]:-}"
        while IFS=$'\t' read -r __zjump_group __zjump_word __zjump_desc; do
            case "${__zjump_group}" in
                match)
                    __zjump_match_words+=("${__zjump_word}")
                    __zjump_match_descs+=("${__zjump_desc}")
                    ;;
                completion)
                    [[ "${__zjump_old_list}" == "yes" ]] || continue
                    __zjump_comp_words+=("${__zjump_word}")
                    __zjump_comp_descs+=("${__zjump_desc}")
                    ;;
                indexed)
                    [[ "${__zjump_old_list}" == "yes" ]] || continue
                    __zjump_idx_words+=("${__zjump_word}")
                    __zjump_idx_descs+=("${__zjump_desc}")
                    ;;
            esac
        done < <(__zjump complete -- "${1}" 2>/dev/null)
    }

    function __zjump_z_complete() {
        # Only show completions when the cursor is at the end of the line.
        # shellcheck disable=SC2154
        [[ "${#words[@]}" -eq "${CURRENT}" ]] || return 0

        if [[ "${#words[@]}" -eq 2 ]]; then
            # zjump extension: frecency keyword completion. Candidates come from
            # the current directory, stored aliases, and the frecency database
            # (current dir first). The first Tab inserts their longest common
            # prefix; a second Tab lists the grouped DIRECTORY / CLOSEST
            # COMPLETIONS / INDEXED sections.
            if [[ -n "${words[2]}" ]]; then
                local -a __zjump_match_words __zjump_match_descs
                local -a __zjump_comp_words __zjump_comp_descs
                local -a __zjump_idx_words __zjump_idx_descs
                __zjump_complete_words "${words[2]}"
                if (( ${#__zjump_match_words[@]} + ${#__zjump_comp_words[@]} + ${#__zjump_idx_words[@]} )); then
                    # On the second Tab, suppress insertion (the fuzzy/indexed
                    # matches don't share the typed prefix) and just list.
                    [[ "${compstate[old_list]:-}" == "yes" ]] && compstate[insert]=''
                    (( ${#__zjump_match_words[@]} )) &&
                        compadd -Q -J zjump-dirs -X '%BDirectories%b' -d __zjump_match_descs -- "${__zjump_match_words[@]}"
                    (( ${#__zjump_comp_words[@]} )) &&
                        compadd -Q -U -J zjump-completions -X '%BClosest completions%b' -d __zjump_comp_descs -- "${__zjump_comp_words[@]}"
                    (( ${#__zjump_idx_words[@]} )) &&
                        compadd -Q -U -J zjump-indexed -X '%BIndexed directories%b' -d __zjump_idx_descs -- "${__zjump_idx_words[@]}"
                    return 0
                fi
            fi
            # No keyword candidates: fall back to native directory completion.
            _cd -/
        # Completing the <path> of `-a`/`--alias <name> <path>`: alias targets
        # are plain filesystem paths, not frecency keywords, so use native
        # directory completion here too, not the interactive fzf flow below.
        # The words[3] != -* guard excludes `-a -d <TAB>` (deleting by name),
        # whose 3rd word is a name, not a path.
        elif [[ "${#words[@]}" -eq 4 &&
            ( "${words[2]}" == "-a" || "${words[2]}" == "--alias" ) &&
            "${words[3]}" != -* ]]; then
            _cd -/
        elif [[ "${words[-1]}" == '' ]]; then
            # Show completions for Space-Tab.
            # shellcheck disable=SC2086
            __zjump_result="$(__zjump query --exclude "$(__zjump_pwd || \builtin true)" --interactive -- ${words[2,-1]} 2>/dev/null)" || __zjump_result=''

            # Set a result to ensure completion doesn't re-run.
            compadd -Q -S "" -- ""

            # Bind '\e[0n' to helper function.
            \builtin bindkey '\e[0n' '__zjump_z_complete_helper'
            # Send query device status code, which results in a '\e[0n' being sent to console input.
            \builtin printf '\e[5n'

            # Report a successful completion so we don't fall back to another function.
            return 0
        fi
    }

    function __zjump_z_complete_helper() {
        if [[ -n "${__zjump_result}" ]]; then
            # shellcheck disable=SC2034,SC2296
            BUFFER="{{ if .HasCmd }}{{ .Cmd }}{{ else }}cd{{ end }} ${(q-)__zjump_result}"
            __zjump_result=''
            \builtin zle reset-prompt
            \builtin zle accept-line
        else
            \builtin zle reset-prompt
        fi
    }
    \builtin zle -N __zjump_z_complete_helper
{{- if .HasCmd }}

    [[ "${+functions[compdef]}" -ne 0 ]] && \compdef __zjump_z_complete {{ .Cmd }}
{{- end }}
fi

# =============================================================================
#
# To initialize zjump, add this to your shell configuration file (usually ~/.zshrc):
#
# eval "$(zjump init zsh)"
